#include <Wire.h>
#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C lcd(0x27, 16, 2); // Adresse I2C (souvent 0x27 ou 0x3F)- adresse de l'écran soit-" 16, 2 " ou "20, 4 "
void setup() {
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("nextgen");
  lcd.setCursor(7, 1);
  lcd.print("coder2010");
}

void loop() {  
  // --- Défilement vers la droite pendant 3 secondes ---
  for (int i = 0; i < 16; i++) { // 16 positions ≈ largeur de l'écran
    lcd.scrollDisplayRight();
    delay(300);  // Vitesse du défilement
  }
  delay(1500); // Pause de 3 secondes

  
  // --- Défilement vers la gauche pendant 3 secondes ---
  for (int i = 0; i < 16; i++) {
    lcd.scrollDisplayLeft();
    delay(300);
  }
  delay(1500); // Pause de 3 secondes

}
